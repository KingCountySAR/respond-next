# Respond's settings on the KCSARA VM: copy to /srv/kcsara/apps/respond/config/app.env there (a copy of this file is in
# apps/respond/current after a deploy). Never commit the real file. Its database is in database.env beside it, from
# `node deploy.mjs database respond` in the vm repo. Organizations, providers and site admins come from a seed file
# (see docs/DEPLOY.md) and the app's admin page, not from here.

# Encrypts the client secrets of the member and sign-in providers in the database: 32 random bytes, in base64
# (`openssl rand -base64 32`). Back it up: without it, the secrets can't be read, and have to be entered again.
SECRETS_KEY=

# Comma-separated emails who are site admins on every site, beside those the admin page keeps.
SITE_ADMINS=

# Optional: a name for the build, which the app shows and sends to its clients.
#BUILD_ID=

# Optional: log every sync message, in and out. Noisy; for chasing a problem.
#SYNC_LOG=1
