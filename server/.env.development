PORT=5174
# The dev sign-in, session tokens and the debug route. Only ever set here or by hand.
DEV_TOOLS=true
# Local Postgres from `npm run db` (docker compose). Remove to use in-memory storage.
DATABASE_URL=postgres://sync:sync@localhost:5433/sync
# One Google callback for every dev site (Google won't take crt.localhost): it sends the code on to
# the site that started the sign-in. Add this URL to the Google client's redirect URIs.
SIGN_IN_CALLBACK=http://localhost:4000/api/auth/callback
