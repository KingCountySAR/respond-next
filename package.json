{
  "name": "respond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --workspace @respond/server run dev",
    "dev:client": "npm --workspace @respond/client run dev",
    "dev": "run-p -rl dev:server dev:client",
    "build:client": "npm --workspace @respond/client run build",
    "build:server": "npm --workspace @respond/server run build",
    "build": "run-s -l build:client build:server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "run-s -cl test typecheck lint",
    "check:fast": "run-p -l test typecheck lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.0.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 220
  }
}
